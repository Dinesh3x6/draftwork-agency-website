# ===================================================
# DRAFTWORK BACKEND (RENDER WEB SERVICE) ENVIRONMENT CONFIG
# ===================================================

# Server Port (Render sets this automatically, default 8080)
PORT=8080

# CORS Allowed Origins (Comma-separated or * for development)
# In production, set to your Vercel frontend URL e.g. https://draftwork.vercel.app
CORS_ORIGIN="http://localhost:8080,http://127.0.0.1:8080"

# Cloud PostgreSQL Database URL (Render Postgres, Supabase, Neon, etc.)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# Founder Email (Notification recipient)
FOUNDER_EMAIL="draftwork30@gmail.com"

# Brevo SMTP Configuration (Nodemailer)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="7f9202001@smtp-brevo.com"
SMTP_PASSWORD="your-brevo-smtp-password"
SMTP_SECURE=false